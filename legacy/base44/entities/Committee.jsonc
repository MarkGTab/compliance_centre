{
  "name": "Committee",
  "properties": {
    "description": {
      "title": "Description",
      "type": "string"
    },
    "is_test_data": {
      "default": "No",
      "description": "Yes for records seeded for testing only - excluded from go-live and wiped by the Test Data panel.",
      "enum": [
        "Yes",
        "No"
      ],
      "title": "Test Data",
      "type": "string"
    },
    "name": {
      "enum": [
        "Board",
        "Board Risk Committee",
        "ERC",
        "Credit Committee",
        "Other"
      ],
      "title": "Name",
      "type": "string"
    },
    "quorum": {
      "default": 0,
      "description": "The minimum number of present members required for the meeting to be quorate.",
      "minimum": 0,
      "title": "Quorum (present members required)",
      "type": "integer"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}