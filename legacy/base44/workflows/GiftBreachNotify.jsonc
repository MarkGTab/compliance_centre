{
  "name": "Gifts & Hospitality \u2014 Breach Notification",
  "description": "When a declaration is flagged BREACH, notify Compliance/MLRO and the employee/approver immediately.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "GiftHospitalityDeclaration",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.compliance_status == \"BREACH\" and .trigger.old_data.compliance_status != \"BREACH\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gift_breach_notify",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyGiftBreach",
            "args": {
              "declaration_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify breach recipients",
            "description": "Compliance, employee & approver"
          }
        }
      }
    ]
  }
}