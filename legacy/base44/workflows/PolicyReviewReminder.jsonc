{
  "name": "Policy Review Reminder",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "policy_review_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "remind": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "policyReviewReminders",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Policy review reminders",
            "description": "30 / 7 / 0 day emails to owners"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 7 * * 1-5",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Daily: email policy owners 30, 7 and 0 days before a review is due."
}