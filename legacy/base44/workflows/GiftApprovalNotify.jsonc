{
  "name": "Gifts & Hospitality \u2014 Approval Request",
  "description": "When a declaration requires prior approval that hasn't been obtained, notify the nominated approver.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "GiftHospitalityDeclaration",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.prior_approval_required == \"Yes\" and .trigger.data.prior_approval_obtained != \"Yes\" and .trigger.old_data.prior_approval_obtained != \"Yes\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gift_approval_notify",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyGiftApproval",
            "args": {
              "declaration_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify approver",
            "description": "Request prior approval"
          }
        }
      }
    ]
  }
}