{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "overdue_action_notify",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyOverdueActionOwners",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Notify overdue action owners",
            "description": "Emails risk owners"
          }
        }
      }
    ]
  },
  "description": "Daily check: email risk owners when actions linked to their risks are overdue.",
  "name": "Overdue Action Owner Notification",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1-5",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}